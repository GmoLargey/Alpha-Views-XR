#include <winver.h>
// Version numbers come from CMakeLists.txt (project VERSION), the only place to change them.

VS_VERSION_INFO VERSIONINFO
FILEVERSION VER_MAJOR,VER_MINOR,VER_PATCH,0
PRODUCTVERSION VER_MAJOR,VER_MINOR,VER_PATCH,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "GmoLargey"
            VALUE "FileDescription", "Alpha Views XR OpenXR layer"
            VALUE "FileVersion", LAYER_VERSION
            VALUE "InternalName", "XR_APILAYER_GMO_alpha_views_xr"
            VALUE "LegalCopyright", "Copyright (C) 2026 GmoLargey. GNU GPL v3."
            VALUE "Comments", "Free software under the GNU GPL version 3. Source: https://github.com/GmoLargey/Alpha-Views-XR"
            VALUE "OriginalFilename", "XR_APILAYER_GMO_alpha_views_xr.dll"
            VALUE "ProductName", "Alpha Views XR"
            VALUE "ProductVersion", LAYER_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
