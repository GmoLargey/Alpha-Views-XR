# Builds the guide panel's gesture pictures into the Linux layer (Windows has them as resources:
# guide_icons.rc). cmake -DOUT=<header> -DDIR=<packaging/gestures> -DRC=<guide_icons.rc> -P embed_bmps.cmake
file(STRINGS ${RC} lines REGEX "^[A-Z_]+ BITMAP ")
set(body "// Made by linux/embed_bmps.cmake from ${RC}.\n#pragma once\n")
set(table "")
set(i 0)
foreach(line ${lines})
    string(REGEX MATCH "^([A-Z_]+) BITMAP \"packaging/gestures/([^\"]+)\"" m "${line}")
    set(name ${CMAKE_MATCH_1})
    set(file ${CMAKE_MATCH_2})
    if(NOT EXISTS ${DIR}/${file})
        message(WARNING "${file} missing (packaging/gen_gestures.ps1 makes it): the guide panel shows no picture there")
        continue()
    endif()
    file(READ ${DIR}/${file} hex HEX)
    string(LENGTH "${hex}" n)
    math(EXPR size "${n} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
    string(REGEX REPLACE "((0x..,){32})" "\\1\n" hex "${hex}")
    string(APPEND body "static const unsigned char kBmp${i}[${size}] = {\n${hex}\n};\n")
    string(APPEND table "    { L\"${name}\", kBmp${i}, ${size} },\n")
    math(EXPR i "${i} + 1")
endforeach()
string(APPEND body "struct EmbeddedBmp { const wchar_t* name; const unsigned char* data; size_t size; };\n")
string(APPEND body "static const EmbeddedBmp kGestureBmps[] = {\n${table}    { nullptr, nullptr, 0 },\n};\n")
file(WRITE ${OUT} "${body}")
